@model IEnumerable<BlogApp.Models.Post>

@{
    ViewData["Title"] = "Makaleler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Makaleler</h2>
    @if (User.IsInRole("Yazar") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">Yeni Makale</a>
    }
</div>

@if (ViewBag.FilterAuthorEmail != null)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span>Yazar: <strong>@ViewBag.FilterAuthorEmail</strong></span>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Filtreyi Kaldır</a>
    </div>
}

<form asp-action="Index" method="get" class="row g-2 mb-4">
    @if (Context.Request.Query["authorId"].Count > 0)
    {
        <input type="hidden" name="authorId" value="@Context.Request.Query["authorId"]" />
    }
    <div class="col-auto">
        <select name="categoryId" class="form-select" asp-items="ViewBag.Categories" onchange="this.form.submit()">
            <option value="">Tüm Kategoriler</option>
        </select>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">Bu kritere uygun makale bulunamadı.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var post in Model)
        {
            @await Html.PartialAsync("_PostCard", post)
        }
    </div>
}

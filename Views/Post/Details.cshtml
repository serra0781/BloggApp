@using System.Security.Claims
@using BlogApp.Models
@model BlogApp.Models.Post

@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canManage = User.IsInRole("Admin") || (User.IsInRole("Yazar") && Model.UserId == currentUserId);
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Makalelere Dön</a>
</div>

<article>
    <span class="badge bg-secondary mb-2">@Model.Category?.Name</span>
    @if (Model.Status != PostStatus.Approved)
    {
        <span class="badge @(Model.Status == PostStatus.Pending ? "bg-warning text-dark" : "bg-danger") mb-2">
            @(Model.Status == PostStatus.Pending ? "Onay Bekliyor" : "Reddedildi")
        </span>
    }
    <h1>@Model.Title</h1>
    <p class="text-muted">
        <a asp-controller="Post" asp-action="Index" asp-route-authorId="@Model.UserId">@Model.User?.Email</a>
        &middot; @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
    </p>
    <hr />
    <p style="white-space: pre-line;">@Model.Content</p>
</article>

@if (canManage)
{
    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Sil</a>
    </div>
}

<hr class="mt-4" />

<h4>Yorumlar (@Model.Comments.Count)</h4>

@if (!Model.Comments.Any())
{
    <p class="text-muted">Henüz yorum yapılmamış.</p>
}
else
{
    foreach (var comment in Model.Comments)
    {
        <div class="border-bottom py-2">
            <div class="d-flex justify-content-between">
                <strong>@comment.User?.Email</strong>
                <small class="text-muted">@comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
            </div>
            <p class="mb-1">@comment.Content</p>
            @if (User.IsInRole("Admin") || comment.UserId == currentUserId)
            {
                <form asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            }
        </div>
    }
}

@if (TempData["CommentError"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["CommentError"]</div>
}

@if (isAuthenticated)
{
    <form asp-controller="Comment" asp-action="Create" method="post" class="mt-3">
        <input type="hidden" name="PostId" value="@Model.Id" />
        <div class="form-group mb-2">
            <textarea name="Content" class="form-control" rows="3" maxlength="1000" placeholder="Yorumunuzu yazın..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Yorum Yap</button>
    </form>
}
else
{
    <p class="text-muted mt-3">Yorum yapmak için <a asp-controller="Account" asp-action="Login">giriş yapmalısınız</a>.</p>
}

@using System.Security.Claims
@using BlogApp.Models
@model BlogApp.Models.Post

@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canManage = User.IsInRole("Admin") || (User.IsInRole("Yazar") && Model.UserId == currentUserId);
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<div class="mb-3 mt-3">
    <a asp-action="Index" class="btn-editorial">&larr; Makalelere Dön</a>
</div>

<article>
    <span class="tag-pill mb-2 d-inline-block">@Model.Category?.Name</span>
    @if (Model.Status != PostStatus.Approved)
    {
        <span class="badge @(Model.Status == PostStatus.Pending ? "bg-warning text-dark" : "bg-danger") mb-2">
            @(Model.Status == PostStatus.Pending ? "Onay Bekliyor" : "Reddedildi")
        </span>
    }
    <h1 style="font-weight: 800; font-size: clamp(1.8rem, 5vw, 2.75rem); line-height: 1.1;">@Model.Title</h1>
    <div class="byline my-2 d-flex align-items-center flex-wrap gap-2">
        <partial name="_Avatar" model="@(new BlogApp.Models.ViewModels.AvatarViewModel { Email = Model.User?.Email, PhotoPath = Model.User?.ProfilePhotoPath, Size = 26, LinkUserId = Model.UserId })" />
        <span><span class="byline-label">Yazar</span><a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.UserId">@(Model.User?.FullName ?? Model.User?.Email)</a></span>
        <span><span class="byline-label">Tarih</span>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
        <partial name="_ViewCount" model="@Model.ViewCount" />
    </div>
    <div class="hairline-thin mt-3 mb-3"></div>
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="editorial-media mb-3" style="aspect-ratio: 16 / 9; background-image:url('@Model.ImagePath'); background-size:cover; background-position:center;"></div>
    }
    <p style="white-space: pre-line;">@Model.Content</p>
</article>

@if (canManage)
{
    <div class="mt-4 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-editorial">Düzenle</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-editorial">Sil</a>
    </div>
}

<div class="hairline mt-4 pt-3">
    <h4 style="font-weight: 800;">Yorumlar (@Model.Comments.Count)</h4>
</div>

@if (!Model.Comments.Any())
{
    <p class="text-muted">Henüz yorum yapılmamış.</p>
}
else
{
    foreach (var comment in Model.Comments)
    {
        <div class="border-bottom py-3">
            <div class="d-flex justify-content-between align-items-start">
                <div class="d-flex align-items-center gap-2">
                    <partial name="_Avatar" model="@(new BlogApp.Models.ViewModels.AvatarViewModel { Email = comment.User?.Email, PhotoPath = comment.User?.ProfilePhotoPath, Size = 34, LinkUserId = comment.UserId })" />
                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@comment.UserId" class="text-decoration-none" style="color: inherit;"><strong>@(comment.User?.FullName ?? comment.User?.Email)</strong></a>
                </div>
                <small class="text-muted">@comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
            </div>
            <p class="mb-1 mt-2" style="margin-left: 2.6rem;">@comment.Content</p>
            @if (User.IsInRole("Admin") || comment.UserId == currentUserId)
            {
                <form asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" method="post" style="margin-left: 2.6rem;">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            }
        </div>
    }
}

@if (TempData["CommentError"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["CommentError"]</div>
}

@if (isAuthenticated)
{
    <form asp-controller="Comment" asp-action="Create" method="post" class="mt-3 d-flex gap-2">
        <div class="mt-1">
            <partial name="_Avatar" model="@(new BlogApp.Models.ViewModels.AvatarViewModel { Email = User.Identity!.Name, PhotoPath = ViewBag.CurrentUserPhotoPath as string, Size = 34 })" />
        </div>
        <div class="flex-grow-1">
            <input type="hidden" name="PostId" value="@Model.Id" />
            <div class="form-group mb-2">
                <textarea name="Content" class="form-control" rows="3" maxlength="1000" placeholder="Yorumunuzu yazın..." required></textarea>
            </div>
            <button type="submit" class="btn-editorial-solid">Yorum Yap</button>
        </div>
    </form>
}
else
{
    <p class="text-muted mt-3">Yorum yapmak için <a asp-controller="Account" asp-action="Login">giriş yapmalısınız</a>.</p>
}

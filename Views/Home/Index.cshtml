@model IEnumerable<BlogApp.Models.Post>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mb-4">
    <h1 class="display-4">BlogApp'e Hoş Geldiniz</h1>
    <p class="lead">Yazarlarımızın en son paylaştığı makaleleri keşfedin.</p>
    <a asp-controller="Post" asp-action="Index" class="btn btn-outline-primary">Tüm Makaleleri Gör</a>
</div>

@if (!Model.Any())
{
    <p class="text-center text-muted">Henüz yayınlanmış bir makale yok.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var post in Model)
        {
            @await Html.PartialAsync("_PostCard", post)
        }
    </div>
}

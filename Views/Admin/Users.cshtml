@model IEnumerable<BlogApp.Models.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "_AdminLayout";
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Kullanıcı</th>
            <th>Roller</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <partial name="_Avatar" model="@(new BlogApp.Models.ViewModels.AvatarViewModel { Email = user.Email, PhotoPath = user.PhotoPath, Size = 32, LinkUserId = user.Id })" />
                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@user.Id">@user.Email</a>
                    </div>
                </td>
                <td>
                    @foreach (var role in user.Roles)
                    {
                        <span class="badge bg-info text-dark me-1">@role</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    ViewData["Title"] = "Yönetim Paneli";
    Layout = "_AdminLayout";
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="admin-stat-card">
            <div class="stat-label">Kullanıcılar</div>
            <div class="stat-number">@ViewBag.UserCount</div>
            <a asp-action="Users" class="btn-editorial">Görüntüle</a>
        </div>
    </div>
    <div class="col">
        <div class="admin-stat-card">
            <div class="stat-label">Makaleler</div>
            <div class="stat-number">@ViewBag.PostCount</div>
            <a asp-controller="Post" asp-action="Index" class="btn-editorial">Görüntüle</a>
        </div>
    </div>
    <div class="col">
        <div class="admin-stat-card">
            <div class="stat-label">Kategoriler</div>
            <div class="stat-number">@ViewBag.CategoryCount</div>
            <a asp-controller="Category" asp-action="Index" class="btn-editorial">Yönet</a>
        </div>
    </div>
    <div class="col">
        <div class="admin-stat-card">
            <div class="stat-label">Onay Bekleyen Makaleler</div>
            <div class="stat-number">@ViewBag.PendingPostCount</div>
            <a asp-controller="Post" asp-action="Pending" class="btn-editorial">İncele</a>
        </div>
    </div>
    <div class="col">
        <div class="admin-stat-card">
            <div class="stat-label">Yorumlar</div>
            <div class="stat-number">@ViewBag.CommentCount</div>
            <a asp-controller="Comment" asp-action="Index" class="btn-editorial">Yönet</a>
        </div>
    </div>
</div>

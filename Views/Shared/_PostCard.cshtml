@model BlogApp.Models.Post

@{
    var initial = !string.IsNullOrEmpty(Model.Title) ? Model.Title.Substring(0, 1).ToUpper() : "?";
    var excerpt = Model.Content.Length > 120 ? Model.Content.Substring(0, 120) + "..." : Model.Content;
}

<div class="col-md-2">
    <article class="editorial-card h-100">
        <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.Id" class="d-block text-decoration-none">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="editorial-media" style="background-image:url('@Model.ImagePath'); background-size:cover; background-position:center;"></div>
            }
            else
            {
                <div class="editorial-media">
                    <span class="initial">@initial</span>
                </div>
            }
        </a>
        <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
            <span class="byline"><span class="byline-label">Tarih</span>@Model.CreatedDate.ToString("dd.MM.yyyy")</span>
            @if (Model.Category != null)
            {
                <a asp-controller="Post" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="tag-pill">@Model.Category.Name</a>
            }
            <partial name="_ViewCount" model="@Model.ViewCount" />
        </div>
        <h3 style="font-weight: 800; font-size: 1.05rem; line-height: 1.25;">
            <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a>
        </h3>
        <p class="text-muted small mb-2">@excerpt</p>
        <div class="byline d-flex align-items-center gap-2">
            <partial name="_Avatar" model="@(new BlogApp.Models.ViewModels.AvatarViewModel { Email = Model.User?.Email, PhotoPath = Model.User?.ProfilePhotoPath, Size = 22, LinkUserId = Model.UserId })" />
            <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.UserId" class="text-muted text-decoration-none">@(Model.User?.FullName ?? Model.User?.Email)</a>
        </div>
    </article>
</div>

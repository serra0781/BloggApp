@model IEnumerable<BlogApp.Models.Category>

@{
    ViewData["Title"] = "Kategoriler";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn-editorial-solid">Yeni Kategori</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Makale Sayısı</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Posts.Count</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

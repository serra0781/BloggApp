@model BlogApp.Models.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Yeni Kategori";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <partial name="_CategoryForm" />
            <button type="submit" class="btn-editorial-solid">Kaydet</button>
            <a asp-action="Index" class="btn-editorial">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
